$TTL 604800
@   IN  SOA example.local. root.example.local. (
            2         ; Serial
            604800    ; Refresh
            86400     ; Retry
            2419200   ; Expire
            604800 )  ; Negative Cache TTL

@       IN  NS      example.local.
@       IN  A       127.0.0.1
mail    IN  A       172.18.0.2
web     IN  A       172.20.0.2  ;
